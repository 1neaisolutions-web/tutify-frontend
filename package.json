{
  "name": "teacher-assistant-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:i18n": "vitest run src/i18n/language.test.ts",
    "test:i18n:watch": "vitest src/i18n/language.test.ts",
    "i18n:build-shell": "node scripts/i18n-build-shell-locales.mjs",
    "i18n:build-full-shells": "node scripts/i18n-build-full-locale-shells.mjs",
    "i18n:translate-shells": "node scripts/i18n-translate-shell-prefixes.mjs",
    "i18n:build-partials": "node scripts/i18n-build-all-partials.mjs",
    "i18n:translate-dashboard": "node scripts/i18n-translate-dashboard-prefixes.mjs",
    "i18n:full-rebuild": "node scripts/i18n-ensure-all-dashboards.mjs",
    "i18n:ensure-dashboards": "node scripts/i18n-ensure-all-dashboards.mjs",
    "i18n:complete": "node scripts/complete-locales.mjs",
    "i18n:complete:single": "node scripts/complete-locales.mjs",
    "i18n:validate": "node scripts/validate-locales.mjs",
    "i18n:validate:strict": "node scripts/validate-locales.mjs --strict --strict-locales=all --max-untranslated=80",
    "i18n:audit-routes": "node scripts/audit-route-i18n.mjs",
    "i18n:audit-quality": "node scripts/audit-locale-quality.mjs",
    "i18n:audit-chatbots": "node scripts/audit-chatbot-i18n.mjs",
    "i18n:translate-priority": "node scripts/translate-priority-namespaces.mjs",
    "i18n:translate-priority-all": "node scripts/translate-priority-namespaces.mjs --all",
    "i18n:fix-priority-english": "node scripts/translate-priority-namespaces.mjs --all --fix-remaining",
    "i18n:force-shell-keys": "node scripts/i18n-force-shell-keys.mjs",
    "i18n:wire-chatbot-tabs": "node scripts/i18n-wire-chatbot-tabs.mjs",
    "i18n:translate-priority-parallel": "node scripts/i18n-translate-priority-parallel.mjs --shards=4",
    "i18n:sync-catalog": "node scripts/sync-content-catalog-i18n.mjs",
    "i18n:merge-all": "node scripts/complete-locales.mjs --merge-only",
    "i18n:seed-prefix-overrides": "node scripts/i18n-seed-prefix-overrides-from-locales.mjs",
    "i18n:complete-shell": "node scripts/complete-shell-keys.mjs",
    "test:templates": "node scripts/test-templates-api.js",
    "test:all-templates": "node scripts/test-all-templates-schema.js",
    "test:stream": "node scripts/test-all-templates-stream.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/x-date-pickers": "^8.23.0",
    "@reduxjs/toolkit": "^2.8.2",
    "apexcharts": "^5.3.6",
    "axios": "^1.10.0",
    "better-react-mathjax": "^2.4.0-beta-1",
    "dayjs": "^1.11.19",
    "docx": "^8.5.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.0.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "mathjax-full": "^3.2.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.6",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.20.0",
    "redux-persist": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.10.17",
    "eslint": "^8.55.0",
    "eslint-plugin-i18next": "^4.2.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.9"
  }
}
